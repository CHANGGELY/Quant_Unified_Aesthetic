# ============================================================
# 8号香农策略 环境变量模板 (Dual Key System)
# ============================================================

# ===== 测试网 API Key (Demo Trading) =====
TESTNET_API_KEY=YOUR_TESTNET_KEY_HERE
TESTNET_SECRET_KEY=YOUR_TESTNET_SECRET_HERE

# ===== 实盘 API Key (Production) =====
REAL_API_KEY=YOUR_REAL_KEY_HERE
REAL_SECRET_KEY=YOUR_REAL_SECRET_HERE

# ===== 运行模式开关 =====
# True = 实盘 (使用 REAL_API_KEY)
# False = 测试网 (使用 TESTNET_API_KEY)
USE_REAL_TRADING=False

# ===== 可选配置 =====
# API 请求限速 (Queries Per Second)
# 建议设为 2~5，太高会被币安封禁 IP
BINANCE_API_MAX_QPS=5
