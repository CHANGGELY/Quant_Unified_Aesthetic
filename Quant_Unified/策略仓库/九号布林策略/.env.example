# 这是配置模板：复制为 .env.local 后再填真实值
#   cp .env.example .env.local
#
# 安全提醒：
# - .env.local 里放的是“密码本”，不要发给任何人，不要打包进压缩包，不要提交到 git。

# ====== 必填：钉钉 ======
# 你的钉钉机器人 Webhook（必须包含关键词“布林”才会推送）
DINGTALK_WEBHOOK_URL=

# ====== 可选：策略参数（不填就用默认）======
BOLL9_SYMBOL=BTCUSDT
BOLL9_USE_TESTNET=false

# 预热：只拉“计算需要的最小数据”
BOLL9_WARMUP_1M_DAYS=12
BOLL9_WARMUP_1D_DAYS=70

# 钉钉限频：1 分钟最多 20 条（你已明确）
BOLL9_DINGTALK_KEYWORD=布林
BOLL9_DINGTALK_RPM_LIMIT=20

# ====== 可选：网络/证书（遇到 CERTIFICATE_VERIFY_FAILED 时再开）======
# BINANCE_WS_SSL_VERIFY=false

# ====== 可选：阈值（不填就用默认）======
# BOLL9_TH_15M_MA_SPREAD=500
# BOLL9_TH_30M_MA_SPREAD=1000
# BOLL9_TH_1H_MA_SPREAD_UP=1800
# BOLL9_TH_1H_MA_SPREAD_DOWN=1500
# BOLL9_TH_4H_MA_SPREAD=1800
# BOLL9_TH_1D_MA_SPREAD=2900

